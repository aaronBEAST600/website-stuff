<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stay Safe Online</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #90d4e8; /* light blue */
    }

    /* Header bar */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #6689b7; /* blue header */
      padding: 15px 40px;
      height: 80px;
      border-bottom: 5px solid #29b8e2; /* bright blue line */
      box-sizing: border-box;
    }

    /* Title */
    .title {
      color: black;
      font-size: 20px;
      font-weight: bold;
    }

    /* Navigation buttons */
    .nav-buttons {
      display: flex;
      gap: 20px;
    }

    .nav-buttons button {
      background-color: #90a9d4;
      border: none;
      padding: 10px 20px;
      cursor: pointer;
      font-size: 16px;
      border-radius: 5px;
      transition: 0.2s;
    }

    .nav-buttons button:hover {
      background-color: #7d97c8;
      color: white;
    }

    /* Main content area */
    .container {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 40px;
    }

    /* Text box */
    .text-box {
      width: 60%;
      min-height: 300px;
      border: 3px solid black;
      background-color: #90d4e8;
      padding: 20px;
      box-sizing: border-box;
      font-size: 16px;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <header>
    <div class="title">Stay Safe Online</div>
    <div class="nav-buttons">
      <li><a href="index">return home</a></li>
      <button>another button</button>
    </div>
  </header>

  <div class="container">
    <div class="text-box">
      <h2>Staying Safe Online</h2>
        <label >Contact email : :</label>
        <input type="text"><br>
        <label >was the form good?:</label>
        <input type="text"><br>
        <label >what would you rate out of 10?:</label>
        <input type="text"><br>
        <label >what would you like to see improved?:</label>
        <input type="text"><br>
        <label >ts goated?:</label>
        <input type="text"><br>
        <label >what would you rate out of 67?:</label>
        <input type="text"><br>
        <label >what content would you like to see covered ?:</label>
        <input type="text"><br>

        <button "send">send</button><br>
    </div>
  </div>
</body>
</html>
